        gui)        _maybe_cmd_help gui "$@";        require_root; source "${CIPI_LIB}/gui.sh";       gui_command "$@" ;;
        git)        _maybe_cmd_help git "$@";        require_root; source "${CIPI_LIB}/git.sh";       git_command "$@" ;;
        sync)       _maybe_cmd_help sync "$@";       require_root; source "${CIPI_LIB}/sync.sh";      sync_command "$@" ;;
        ssh)        _maybe_cmd_help ssh "$@";        require_root; source "${CIPI_LIB}/ssh.sh";       ssh_command "$@" ;;
        smtp)       _maybe_cmd_help smtp "$@";       require_root; source "${CIPI_LIB}/smtp.sh";      smtp_command "$@" ;;
        notifications) _maybe_cmd_help notifications "$@"; require_root; source "${CIPI_LIB}/notifications.sh"; notifications_command "$@" ;;
        reset)      _maybe_cmd_help reset "$@";      require_root; source "${CIPI_LIB}/reset.sh";     reset_command "$@" ;;
        *) error "Unknown command: $cmd"; echo "Run 'cipi help'"; exit 1 ;;
    esac
}

main "$@"
exit
}
