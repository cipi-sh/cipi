            _help_note "  cipi yml example <app> > cipi.yml"
            echo ""
            _help_note "Looked up in current/cipi.yml, current/cipi.yaml, htdocs/cipi.yml, shared/cipi.yml"
            _help_note "(override with --file=<path>)."
            _help_note "It can only configure an existing app: databases must be named <app> or"
            _help_note "<app>_*, backup profiles <app> or <app>-*, the healthcheck URL must be one"
            _help_note "of the app's own domains."
            echo ""
            ;;

        nginx)
            _help_topic_header "Nginx"
            echo ""
            _help_cmd "cipi nginx show <app>"            "The app's own nginx directives  ${DIM}[--json]${NC}"
            _help_cmd "cipi nginx edit <app>"            "Edit them in \$EDITOR, test, reload"
            _help_cmd "cipi nginx set <app> --file=<path>" "The same from a file (- for stdin)"
            _help_cmd "cipi nginx reset <app>"           "Remove them"
            _help_note "Headers, caching, limits, rewrites, locations of your own: kept by Cipi and"
            _help_note "included in the app's server block, so they survive every change of the"
            _help_note "vhost. Tested with nginx -t first; refused, nothing changes. From the API"
            _help_note "a subset only (no access_log path, include, listen, server_name, *_pass)."
            echo ""
            _help_cmd "cipi nginx real-ip cloudflare"    "Behind Cloudflare's proxy: the visitor's real address"
            _help_cmd "cipi nginx real-ip status"        "Whether it is on, and how many ranges  ${DIM}[--json]${NC}"
            _help_cmd "cipi nginx real-ip off"           "Back to the address of each connection  ${DIM}[--yes]${NC}"
            _help_note "For domains proxied by Cloudflare (orange cloud) without a tunnel: the access"
            _help_note "log, fail2ban, CrowdSec and the app see the visitor, not Cloudflare. Only requests"
            _help_note "from Cloudflare's ranges are believed; the ranges are refreshed every night."
            _help_note "From the panel too: the server's Firewall tab (on, refresh, off)."
            echo ""
            _help_cmd "cipi nginx default-server status" "Who answers requests matching no app"
            _help_cmd "cipi nginx default-server on"     "Close unmatched requests (444)"
            _help_cmd "cipi nginx default-server off"    "Let the first vhost answer them again"
            _help_cmd "cipi nginx upgrade"               "Patch nginx from nginx.org  ${DIM}[--yes]${NC}"
            _help_cmd "cipi nginx security"              "Patch level, running binary, HTTP/2 exposure"
            _help_note "Keeps /etc/nginx/nginx.conf (force-confold), tests, then reloads — or"
            _help_note "restarts, when the binary from before the upgrade is still in memory."
            _help_note "On the Ubuntu archive's nginx, upgrade moves it to nginx.org mainline."
            echo ""
            _help_note "Recommended with wildcard/multi-tenant apps: without it an HTTPS request"
            _help_note "carrying an unknown Host lands on whichever app sorts first, and its"
            _help_note "tenant resolver receives a hostname it cannot parse."
            echo ""
            ;;

        smtp|mail|email)
            _help_topic_header "SMTP (a notification channel)"
            echo ""
            _help_cmd "cipi notification add smtp --host= --user= --password= --from= --to=" "Configure  ${DIM}[--port=587] [--tls=on|off] [--no-test]${NC}"
            _help_cmd "cipi notification test|enable|disable|remove smtp" "Test, toggle, remove"
            _help_cmd "cipi smtp configure|status|test|enable|disable|delete" "The same, as before 5.10.0  ${DIM}(status --json)${NC}"
            _help_note "The configuration in /etc/cipi/smtp.json is the same one: nothing to redo. See: cipi help notification"
            echo ""
            ;;

        notification|notifications|notify|triggers|channels)
            _help_topic_header "Notifications"
            echo ""
            _help_cmd "cipi notification [--json]"          "Every channel (SMTP included) and how many triggers are on"
            _help_cmd "cipi notification add <type> <id> …" "Add a channel"
            _help_cmd "  smtp --host= --user= --password= --from= --to=" "Email through an SMTP server (one per server)"
            _help_cmd "  resend <id> --api-key=re_… --from= --to=a,b"   "Email through the Resend API"
            _help_cmd "  ses <id> --region= --access-key= --secret-key= --from= --to=" "Email through Amazon SES (API v2)"
            _help_cmd "  slack|discord|mattermost|googlechat <id> --url=" "Incoming webhook of the chat"
            _help_cmd "  telegram <id> --token=<bot-token> --chat-id=<id>" "Bot from @BotFather"
            _help_cmd "  ntfy <id> --url=https://ntfy.sh/<topic> [--priority=]" "Push to a phone"
            _help_cmd "  pushover <id> --token=<app> --user=<user key>"   "Push to a phone"
            _help_cmd "  webhook <id> --url= [--secret=]"                 "JSON POST; with a secret, X-Cipi-Signature: sha256=…"
            _help_cmd "cipi notification update <id> …"     "Change a channel; what is left out (secrets too) is kept  ${DIM}[--clear-secret]${NC}"
            _help_cmd "cipi notification test <id>|all"     "Send a test (exit 1 when the channel refuses it)"
            _help_cmd "cipi notification enable|disable|remove <id>" "Toggle or remove a channel"
            _help_cmd "cipi notification triggers"          "Which events notify  ${DIM}enable|disable <t> · enable-all · disable-all · reset${NC}"
            _help_cmd "cipi notification triggers set --on=a,b --off=c" "Many at once  ${DIM}triggers --json: the list as JSON${NC}"
            _help_cmd "cipi notification events"            "What each channel takes  ${DIM}[--json]${NC}"
            _help_cmd "cipi notification events <id> <what>" "Only these events to a channel: categories, triggers, urgent — or all"
            _help_note "e.g. events telegram security,deploy · events pager urgent · events mail all (everything, the default)."
            _help_note "Categories: apps domains deploy health monitor backup security ssl php database … (cipi notification events)."
            _help_note "urgent: failures and security events. add|update <id> … --events=… sets it with the channel."
            _help_cmd "cipi notification timezone [<Area/City>|server]" "The zone the Time of a notification is written in  ${DIM}[--json]${NC}"
            _help_cmd "cipi notification server-name [<name>]" "The name the server goes by in notifications  ${DIM}[--clear] [--json]${NC}"
            _help_note "timezone Europe/Rome changes how notifications read, not the server's clock; server-name"
            _help_note "production turns \"vmi12334\" into \"production (vmi12334)\" — the name the panel knows it by."
            _help_note "A secret left out of the command line is asked for on a terminal, not echoed. Secrets are kept in the vault."
            _help_note "cipi notifications (the older name), its channel … subcommands and cipi smtp keep working."
            _help_note "See also: cipi help monitor"
            echo ""
            ;;

        reset|passwords)
            _help_topic_header "Reset"
            echo ""
            _help_cmd "cipi reset root-password"       "Reset root SSH password"
            _help_cmd "cipi reset db-password"         "Reset DB root password  ${DIM}[--engine=]${NC}"
            _help_cmd "cipi reset valkey-password"     "Reset Valkey password"
            _help_note "The current ones, again: cipi credentials"
            echo ""
            ;;

        credentials|creds)
            _help_topic_header "Credentials"
            echo ""
            _help_cmd "cipi credentials"               "The install summary again: root, MariaDB, PostgreSQL, Valkey, Meilisearch, backup key"
            _help_cmd "cipi credentials export"        "CSV for a password manager  ${DIM}[--output=FILE]${NC}"
            _help_note "title,url,username,password,notes — 1Password, Bitwarden, Apple Passwords, Chrome, KeePassXC, Proton Pass import it"
            _help_note "Nothing left on the server: ssh cipi@<ip> sudo cipi credentials export > cipi.csv"
            _help_note "Every show or export is logged and notified (trigger credentials_show)"
            echo ""
            ;;

        all|full)
            show_help_all
            ;;

        *)
            error "Unknown help topic: ${topic}"
            echo -e "  Topics: $(_help_topics_list | tr '\n' ' ' | sed 's/ *$//')"
            echo -e "  Or run: ${CYAN}cipi help${NC} / ${CYAN}cipi help all${NC}"
            exit 1
            ;;
    esac
}

# Full dump (former monolithic help) for power users / docs.
show_help_all() {
    show_logo
    echo -e "${GREEN}Cipi${NC} ${YELLOW}${CIPI_VERSION}${NC} ${DIM}— all commands, with their options${NC}"
    echo -e "  ${DIM}A shorter view: ${GREEN}cipi help${DIM} (the list) or ${GREEN}cipi help <topic>${NC}"

    CIPI_HELP_INLINE=1
    local t
    for t in "${_HELP_TOPICS[@]}"; do show_help_topic "$t"; done
    unset CIPI_HELP_INLINE
    echo ""
}

show_status() {
    show_logo
    echo -e "${BOLD}Server Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    local ip; ip=$(curl -s --max-time 5 https://checkip.amazonaws.com 2>/dev/null || echo "N/A")
    echo -e "\n${BOLD}System${NC}"
    printf "  %-14s ${CYAN}%s${NC}\n" "IP" "$ip"
    printf "  %-14s ${CYAN}%s${NC}\n" "Hostname" "$(hostname)"
    printf "  %-14s ${CYAN}%s${NC}\n" "OS" "$(lsb_release -ds 2>/dev/null)"
    printf "  %-14s ${CYAN}%s${NC}\n" "Uptime" "$(uptime -p 2>/dev/null)"
    printf "  %-14s ${CYAN}v%s${NC}\n" "Cipi" "$CIPI_VERSION"

    local cpu; cpu=$(top -bn1 2>/dev/null | grep -E "Cpu|CPU" | head -1 | awk '{print $2}' | cut -d. -f1) || cpu="?"
    local mem_total; mem_total=$(free -m | awk '/^Mem:/{print $2}')
    local mem_used; mem_used=$(free -m | awk '/^Mem:/{print $3}')
    echo -e "\n${BOLD}Resources${NC}"
    printf "  %-14s ${CYAN}%s%%${NC}\n" "CPU" "$cpu"
    printf "  %-14s ${CYAN}%sMB / %sMB (%s%%)${NC}\n" "Memory" "$mem_used" "$mem_total" "$((mem_used*100/mem_total))"
    printf "  %-14s ${CYAN}%s${NC}\n" "Disk" "$(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')"

    echo -e "\n${BOLD}Services${NC}"
    local -a status_svcs=(nginx mariadb supervisor fail2ban)
    systemctl list-unit-files --quiet postgresql.service &>/dev/null && status_svcs+=(postgresql)
    # Opt-in, so it is listed only where it exists.
    systemd_unit_exists meilisearch && status_svcs+=(meilisearch)
    systemd_unit_exists crowdsec && status_svcs+=(crowdsec)
    systemd_unit_exists crowdsec-firewall-bouncer && status_svcs+=(crowdsec-firewall-bouncer)
    # The rescue listener is the way back in after a ban; a silent one is worse
    # than no listener at all, so it belongs on the status page.
    systemd_unit_exists cipi-crowdsec-rescue && status_svcs+=(cipi-crowdsec-rescue)
    systemd_unit_exists cloudflared && status_svcs+=(cloudflared)
    for svc in "${status_svcs[@]}"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            printf "  %-26s ${GREEN}● running${NC}\n" "$svc"
        elif systemctl list-unit-files --quiet "${svc}.service" &>/dev/null; then
            printf "  %-26s ${RED}● stopped${NC}\n" "$svc"
        else
            printf "  %-26s ${DIM}● not installed${NC}\n" "$svc"
        fi
    done

    # Every version Cipi ever installed: a server set up before 4.5.4 can
    # still run apps on 7.4–8.2, and a running FPM belongs on this page.
    echo -e "\n${BOLD}PHP${NC}"
    for v in 7.4 8.0 8.1 8.2 8.3 8.4 8.5 8.6; do
        if systemctl is-active --quiet "php${v}-fpm" 2>/dev/null; then
            local pools; pools=$(ls /etc/php/${v}/fpm/pool.d/*.conf 2>/dev/null | wc -l)
            printf "  %-16s ${GREEN}● running${NC} (%d pools)\n" "PHP $v" "$pools"
        fi
    done

    local count=0
    [[ -f "${CIPI_CONFIG}/apps.json" ]] && count=$(vault_read apps.json | jq 'length' 2>/dev/null || echo 0)
    echo -e "\n${BOLD}Apps:${NC} ${CYAN}${count}${NC}\n"

    # A reboot, a patch or a warning that is waiting: printed only when
    # there is one. Never the reason `cipi status` fails.
    if [[ -f "${CIPI_LIB}/pending.sh" ]]; then
        # shellcheck source=/dev/null
        source "${CIPI_LIB}/pending.sh"
        ( pending_status_section ) 2>/dev/null || true
    fi
}

main() {
    [[ $# -eq 0 ]] && { show_help; exit 0; }

    local cmd="$1"; shift || true

    # `cipi use <app>`: where a command needs an app and none was given, the
    # default is filled in (lib/use.sh). Nothing to do when none is set.
    if [[ "$cmd" != "use" ]] && [[ -n "${CIPI_APP:-}" || -f /var/lib/cipi/default-app ]]; then
        source "${CIPI_LIB}/use.sh"
        use_fill_args "$cmd" "$@"
        if [[ ${#USE_ARGV[@]} -gt 0 ]]; then set -- "${USE_ARGV[@]}"; else set --; fi
    fi

    case "$cmd" in
        help|--help|-h)       show_help "$@" ;;
        version|--version|-v) echo "Cipi v${CIPI_VERSION}" ;;
        completion)           source "${CIPI_LIB}/completion.sh"; completion_command "$@" ;;
        use)        _maybe_cmd_help use "$@";        require_root; source "${CIPI_LIB}/use.sh";         use_command "$@" ;;
        status)     require_root; show_status ;;
        pending)    _maybe_cmd_help updates "$@";    require_root; source "${CIPI_LIB}/pending.sh";     pending_command "$@" ;;
        reboot)     _maybe_cmd_help updates "$@";    require_root; source "${CIPI_LIB}/pending.sh";     reboot_command "$@" ;;
        autoupdate|autoupdates) _maybe_cmd_help updates "$@"; require_root; source "${CIPI_LIB}/autoupdate.sh"; autoupdate_command "$@" ;;
        valkey)     _maybe_cmd_help valkey "$@";     require_root; source "${CIPI_LIB}/valkey.sh";      valkey_command "$@" ;;
        cache)      _maybe_cmd_help cache "$@";      require_root; source "${CIPI_LIB}/cache.sh";       cache_command "$@" ;;
        disk)       _maybe_cmd_help server "$@";     require_root; source "${CIPI_LIB}/disk.sh";        disk_command "$@" ;;
        app)        _maybe_cmd_help app "$@";        require_root; source "${CIPI_LIB}/app.sh";         app_command "$@" ;;
        alias)      _maybe_cmd_help domains "$@";    require_root; source "${CIPI_LIB}/app.sh";         alias_command "$@" ;;
        domains)    _maybe_cmd_help domains "$@";    require_root; source "${CIPI_LIB}/app.sh";         domains_command "$@" ;;
        www)        _maybe_cmd_help www "$@";        require_root; source "${CIPI_LIB}/app.sh";         www_command "$@" ;;
        redirect|redirects) _maybe_cmd_help redirect "$@"; require_root; source "${CIPI_LIB}/routes.sh"; redirect_command "$@" ;;
        proxy)      _maybe_cmd_help proxy "$@";      require_root; source "${CIPI_LIB}/routes.sh";      proxy_command "$@" ;;
        auth)       _maybe_cmd_help auth "$@";       require_root; source "${CIPI_LIB}/app.sh";         auth_command "$@" ;;
        basicauth)  _maybe_cmd_help basicauth "$@";  require_root; source "${CIPI_LIB}/app.sh";         basicauth_command "$@" ;;
        deploy)     _maybe_cmd_help deploy "$@";     require_root; source "${CIPI_LIB}/deploy.sh";      deploy_command "$@" ;;
        worker)     _maybe_cmd_help worker "$@";     require_root; source "${CIPI_LIB}/worker.sh";      worker_command "$@" ;;
        schedule)   _maybe_cmd_help schedule "$@";   require_root; source "${CIPI_LIB}/app.sh";         schedule_command "$@" ;;
        health)     _maybe_cmd_help health "$@";     require_root; source "${CIPI_LIB}/health.sh";      health_command "$@" ;;
        monitor)    _maybe_cmd_help monitor "$@";    require_root; source "${CIPI_LIB}/monitor.sh";     monitor_command "$@" ;;
        metrics)    _maybe_cmd_help metrics "$@";    require_root; source "${CIPI_LIB}/metrics.sh";     metrics_command "$@" ;;
        db)         _maybe_cmd_help db "$@";         require_root; source "${CIPI_LIB}/db.sh";          db_command "$@" ;;
        search)     _maybe_cmd_help search "$@";     require_root; source "${CIPI_LIB}/search.sh";      search_command "$@" ;;
        node)       _maybe_cmd_help node "$@";       require_root; source "${CIPI_LIB}/node.sh";        node_command "$@" ;;
        ssl)        _maybe_cmd_help ssl "$@";        require_root; source "${CIPI_LIB}/ssl.sh";         ssl_command "$@" ;;
        php)        _maybe_cmd_help php "$@";        require_root; source "${CIPI_LIB}/php.sh";         php_command "$@" ;;
        frankenphp|franken) _maybe_cmd_help frankenphp "$@"; require_root; source "${CIPI_LIB}/frankenphp.sh"; frankenphp_command "$@" ;;
        package|packages) _maybe_cmd_help package "$@"; require_root; source "${CIPI_LIB}/package.sh"; package_command "$@" ;;
        firewall)   _maybe_cmd_help firewall "$@";   require_root; source "${CIPI_LIB}/firewall.sh";    firewall_command "$@" ;;
        ban)        _maybe_cmd_help ban "$@";        require_root; source "${CIPI_LIB}/ban.sh";         ban_command "$@" ;;
        crowdsec)   _maybe_cmd_help crowdsec "$@";   require_root; source "${CIPI_LIB}/crowdsec.sh";    crowdsec_command "$@" ;;
        zt|zerotrust) _maybe_cmd_help zt "$@";       require_root; source "${CIPI_LIB}/zt.sh";        zt_command "$@" ;;
        scan)       _maybe_cmd_help scan "$@";       require_root; source "${CIPI_LIB}/scan.sh";        scan_command "$@" ;;
        compliance) _maybe_cmd_help compliance "$@"; require_root; source "${CIPI_LIB}/compliance.sh";  compliance_command "$@" ;;
        backup)     _maybe_cmd_help backup "$@";     require_root; source "${CIPI_LIB}/backup.sh";      backup_command "$@" ;;
        ini)        _maybe_cmd_help ini "$@";        require_root; source "${CIPI_LIB}/ini.sh";         ini_command "$@" ;;
        yml|yaml)   _maybe_cmd_help yml "$@";        require_root; source "${CIPI_LIB}/yml.sh";        yml_command "$@" ;;
        nginx)      _maybe_cmd_help nginx "$@";      require_root; source "${CIPI_LIB}/nginx.sh";      nginx_command "$@" ;;
        self-update) _maybe_cmd_help server "$@";    require_root; source "${CIPI_LIB}/self-update.sh"; selfupdate_command "$@" ;;
        service)    _maybe_cmd_help service "$@";    require_root; source "${CIPI_LIB}/service.sh";    service_command "$@" ;;
        api)        _maybe_cmd_help api "$@";        require_root; source "${CIPI_LIB}/api.sh";       api_command "$@" ;;
        gui)        _maybe_cmd_help gui "$@";        require_root; source "${CIPI_LIB}/gui.sh";       gui_command "$@" ;;
        git)        _maybe_cmd_help git "$@";        require_root; source "${CIPI_LIB}/git.sh";       git_command "$@" ;;
        sync)       _maybe_cmd_help sync "$@";       require_root; source "${CIPI_LIB}/sync.sh";      sync_command "$@" ;;
        ssh)        _maybe_cmd_help ssh "$@";        require_root; source "${CIPI_LIB}/ssh.sh";       ssh_command "$@" ;;
        smtp)       _maybe_cmd_help smtp "$@";       require_root; source "${CIPI_LIB}/smtp.sh";      smtp_command "$@" ;;
        notification|notifications) _maybe_cmd_help notification "$@"; require_root; source "${CIPI_LIB}/notifications.sh"; notifications_command "$@" ;;
        reset)      _maybe_cmd_help reset "$@";      require_root; source "${CIPI_LIB}/reset.sh";     reset_command "$@" ;;
        credentials|creds) _maybe_cmd_help credentials "$@"; require_root; source "${CIPI_LIB}/credentials.sh"; credentials_command "$@" ;;
        *) error "Unknown command: $cmd"; echo "Run 'cipi help'"; exit 1 ;;
    esac
}

main "$@"
exit
}
