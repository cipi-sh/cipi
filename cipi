#!/bin/bash

#############################################
# Cipi - Server Control Panel for Laravel
# Version: see /etc/cipi/version
# Author: Andrea Pollastri
# License: MIT
#############################################

set -euo pipefail
{

readonly CIPI_LIB="/opt/cipi/lib"
readonly CIPI_CONFIG="/etc/cipi"
readonly CIPI_VERSION="$(tr -d '[:space:]' < "${CIPI_CONFIG}/version" 2>/dev/null || echo "unknown")"
readonly CIPI_LOG="/var/log/cipi"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; DIM=$'\033[2m'; NC=$'\033[0m'; BOLD=$'\033[1m'

[[ -f "${CIPI_LIB}/common.sh" ]] || {
    echo "Cipi: missing ${CIPI_LIB}/common.sh — run the installer: curl -sSL https://cipi.sh/setup.sh | sudo bash" >&2
    exit 1
}
source "${CIPI_LIB}/common.sh"

require_root() {
    if [[ $EUID -ne 0 ]]; then
        error "Run as root: sudo cipi $*"
        exit 1
    fi
}

# If first arg is help/-h/--help, show topic help and exit.
_maybe_cmd_help() {
    local topic="$1" arg="${2:-}"
    case "$arg" in
        help|--help|-h) show_help "$topic"; exit 0 ;;
    esac
}

show_logo() {
    echo -e "${GREEN}${BOLD}"
    echo " ██████ ██ ██████  ██"
    echo "██      ██ ██   ██ ██"
    echo "██      ██ ██████  ██"
    echo "██      ██ ██      ██"
    echo " ██████ ██ ██      ██"
    echo -e "${NC}"
}

# ── Help helpers ─────────────────────────────────────────────
_help_h()    { echo -e "\n  ${BOLD}${CYAN}$1${NC}"; }
_help_cmd()  { printf "    ${CYAN}%-44s${NC} %s\n" "$1" "$2"; }
_help_note() { echo -e "    ${DIM}$1${NC}"; }
_help_topic_header() {
    if [[ -n "${CIPI_HELP_INLINE:-}" ]]; then
        echo -e "\n  ${BOLD}${CYAN}$1${NC}"
        echo -e "  ${DIM}────────────────────────────────────────${NC}"
    else
        show_logo
        echo -e "${BOLD}Cipi v${CIPI_VERSION}${NC} ${DIM}— $1${NC}"
    fi
}

_help_topics_list() {
    cat <<'EOF'
app  domains  www  deploy  worker  schedule  health  monitor  db  search  service  ssl
php  package  auth  basicauth  ssh  firewall  ban  crowdsec  zt  scan  backup  sync
git  ini  yml  nginx  api  gui  smtp  notifications  reset  server  completion
EOF
}

show_help() {
    local topic="${1:-}"

    if [[ -n "$topic" ]]; then
        show_help_topic "$topic"
        return
    fi

    show_logo
    echo -e "${BOLD}Cipi v${CIPI_VERSION}${NC} ${DIM}— Server Control Panel for Laravel${NC}"
    echo ""
    echo -e "  Usage:  ${CYAN}cipi <command> [args]${NC}"
    echo -e "          ${CYAN}cipi help <topic>${NC}"
    echo ""
    echo -e "  ${BOLD}Core${NC}"
    _help_cmd "cipi status"              "Server overview"
    _help_cmd "cipi version"             "Cipi version"
    _help_cmd "cipi self-update"         "Update Cipi  ${DIM}[--check]${NC}"
    _help_cmd "cipi completion bash|zsh" "Shell tab-completion"
    _help_cmd "cipi service ..."           "nginx, mariadb, php-fpm, ..."
    echo ""
    echo -e "  ${BOLD}Apps & deploy${NC}"
    _help_cmd "cipi app ..."               "Create, edit, logs, env, ..."
    _help_cmd "cipi domains / alias / www" "Domains, aliases & www redirects"
    _help_cmd "cipi deploy <app>"        "Deploy / rollback / webhook"
    _help_cmd "cipi worker ..."            "Queue workers / Horizon"
    _help_cmd "cipi schedule ..."          "Laravel scheduler on/off"
    _help_cmd "cipi health ..."            "HTTP healthchecks, incl. post-deploy"
    _help_cmd "cipi monitor ..."           "Server checks: disk, ssl, services, workers, 5xx"
    _help_cmd "cipi db ..."                "Databases"
    _help_cmd "cipi search ..."            "Meilisearch for Scout (opt-in)  ${DIM}install|enable${NC}"
    echo ""
    echo -e "  ${BOLD}Security & access${NC}"
    _help_cmd "cipi ssl / ssh / firewall / ban"  "Certs, keys, firewall, bans"
    _help_cmd "cipi crowdsec ..."          "IP reputation (opt-in)  ${DIM}enable|disable|status|rescue${NC}"
    _help_cmd "cipi zt ..."                "Cloudflare Zero Trust (opt-in)  ${DIM}enable|hostname|access|lock${NC}"
    _help_cmd "cipi scan ..."              "Nightly malware scan (opt-in)  ${DIM}enable|disable|<app>${NC}"
    _help_cmd "cipi auth / basicauth ..."  "Composer auth.json & HTTP basic auth"
    _help_cmd "cipi reset ..."             "Reset root / DB / Valkey passwords"
    echo ""
    echo -e "  ${BOLD}Panel${NC}"
    _help_cmd "cipi api ..."               "REST API for the control panel"
    _help_cmd "cipi gui ..."               "Web control panel"
    echo ""
    echo -e "  ${BOLD}Ops${NC}"
    _help_cmd "cipi php / ini"                   "PHP versions and php.ini settings"
    _help_cmd "cipi package ..."                 "Optional tools  ${DIM}ffmpeg, image optimisers, pdftotext${NC}"
    _help_cmd "cipi backup ..."                  "Backup profiles, schedules, retention"
    _help_cmd "cipi yml ..."                     "Apply a project's cipi.yml"
    _help_cmd "cipi nginx / sync / git"          "Default server, migrate apps, Git tokens"
    _help_cmd "cipi smtp / notifications"        "Email alerts & triggers"
    echo ""
    echo -e "  ${DIM}Detailed help:${NC}  ${CYAN}cipi help <topic>${NC}"
    echo -e "  ${DIM}Topics:${NC}         $(_help_topics_list | tr '\n' ' ' | sed 's/  */ /g')"
    echo -e "  ${DIM}Everything:${NC}     ${CYAN}cipi help all${NC}"
    echo ""
}

show_help_topic() {
    local topic
    topic=$(echo "${1:-}" | tr '[:upper:]' '[:lower:]')

    case "$topic" in
        server|core|status|self-update|version)
            _help_topic_header "Server"
            echo ""
            _help_cmd "cipi status"                    "Server status"
            _help_cmd "cipi version"                   "Cipi version"
            _help_cmd "cipi self-update [--check]"     "Update Cipi"
            echo ""
            ;;

        completion|complete)
            _help_topic_header "Shell completion"
            echo ""
            _help_cmd "cipi completion bash [--print]"  "Install bash tab-completion"
            _help_cmd "cipi completion zsh [--print]"   "Install zsh tab-completion"
            echo ""
            _help_note "setup.sh and every 'cipi self-update' install this for every"
            _help_note "shell already (/etc/bash_completion.d + /etc/profile.d) — you only"
            _help_note "need this command for a non-login shell or a custom rc file."
            _help_note "It writes /etc/bash_completion.d/cipi and a loader in your rc file;"
            _help_note "--print writes the script to stdout and changes nothing."
            _help_note "App names complete when you can read /etc/cipi/apps-public.json"
            _help_note "(root or the cipi-api group); the rest is static."
            echo ""
            ;;

        service|services)
            _help_topic_header "Services"
            echo ""
            _help_cmd "cipi service list [service]"         "Services status"
            _help_cmd "cipi service restart [service|all]"  "Restart service(s)"
            _help_cmd "cipi service start <service>"        "Start a service"
            _help_cmd "cipi service stop <service>"         "Stop a service"
            _help_cmd "cipi service upgrade [name]"         "Patch nginx / MariaDB / PostgreSQL / Valkey  ${DIM}[--yes]${NC}"
            _help_note "services: nginx mariadb postgresql supervisor fail2ban crowdsec cloudflared php<ver>-fpm"
            _help_note "upgrade is patch-level only and asks first (these are not unattended)."
            _help_note "No name lists installed versions. PHP: cipi php upgrade (weekly cron)."
            echo ""
            ;;

        app|apps)
            _help_topic_header "Apps"
            _help_h "Lifecycle"
            _help_cmd "cipi app create [--custom]"     "Create app  ${DIM}[--engine=] [--octane]${NC}"
            _help_note "Laravel Octane: --octane or --octane=frankenphp (no FPM; Nginx → Octane)"
            _help_cmd "cipi app list"                  "List apps"
            _help_cmd "cipi app show <app>"            "App details"
            _help_cmd "cipi app edit <app>"            "Edit app  ${DIM}[--domain=] [--php=] [--node-build=]${NC}"
            _help_cmd "cipi app convert <app>"         "FPM ↔ Octane  ${DIM}--to=octane|fpm${NC}"
            _help_cmd "cipi app clone <app>"           "Clone app (staging)  ${DIM}--domain= [--with-db]${NC}"
            _help_cmd "cipi app reverb …"              "Reverb WebSockets  ${DIM}enable|disable|status${NC}"
            _help_note "enable [--restart-supervisor] — lifts Supervisor's open-file limit now (restarts every worker)"
            _help_cmd "cipi app limits <app>"          "Resource limits  ${DIM}[--fpm-max-children=]${NC}"
            _help_cmd "cipi app delete <app>"          "Delete app"
            _help_cmd "cipi app suspend <app>"         "Take offline (503)"
            _help_cmd "cipi app unsuspend <app>"       "Bring back online"
            _help_h "Runtime"
            _help_cmd "cipi app env <app>"             "Edit .env (nano)  ${DIM}[--show|--get=K|--set=K=V|--unset=K] [--json]${NC}"
            _help_cmd "cipi app logs <app> [--type=T]" "Tail logs"
            _help_cmd "cipi app tinker <app>"          "Laravel Tinker"
            _help_cmd "cipi app artisan <app> <cmd>"   "Artisan command"
            _help_cmd "cipi app run <app> <cmd> …"     "Whitelisted non-interactive cmd  ${DIM}(composer, npm, ls, …)${NC}"
            _help_cmd "cipi app run --commands"        "List allowed app run binaries  ${DIM}[--json]${NC}"
            _help_cmd "cipi app deploy-config <app>"   "Show/edit deploy.php options  ${DIM}[--json] [--keep-releases=N] …${NC}"
            _help_h "Credentials"
            _help_cmd "cipi app reset-password <app>"    "Reset app SSH password"
            _help_cmd "cipi app reset-db-password <app>" "Reset app DB password"
            _help_h "Repair"
            _help_cmd "cipi app fix-permissions [app]"   "Restore home/.ssh/.env/logs modes"
            echo ""
            ;;

        domain|domains|alias|aliases)
            _help_topic_header "Domains & aliases"
            echo ""
            _help_cmd "cipi domains"                   "Map all domains/aliases to apps"
            _help_cmd "cipi alias add <app> <domain>"  "Add alias"
            _help_cmd "cipi alias remove <app> <domain>" "Remove alias"
            _help_cmd "cipi alias list <app>"          "List aliases"
            _help_note "A domain may be a wildcard (*.example.com), as primary or as alias."
            _help_note "Wildcard certificates are DNS-01 only: cipi ssl install <app> --dns=cloudflare"
            _help_note "See also: cipi help www"
            echo ""
            ;;

        www)
            _help_topic_header "WWW redirects"
            echo ""
            _help_cmd "cipi www add <app>"             "Add www (or apex) alias"
            _help_cmd "cipi www force-to-root <app>"   "Redirect www → apex"
            _help_cmd "cipi www force-from-root <app>" "Redirect apex → www"
            _help_cmd "cipi www clear <app>"           "Clear www canonical redirect"
            _help_cmd "cipi www status <app>"          "Show www redirect status"
            echo ""
            ;;

        auth)
            _help_topic_header "Composer auth.json"
            echo ""
            _help_cmd "cipi auth create <app>"         "Create auth.json in shared  ${DIM}[--force]${NC}"
            _help_cmd "cipi auth edit <app>"           "Edit auth.json  ${DIM}[--file=PATH]${NC}"
            _help_cmd "cipi auth show <app>"           "Show auth.json content  ${DIM}[--json]${NC}"
            _help_cmd "cipi auth delete <app>"         "Delete auth.json  ${DIM}[--force]${NC}"
            echo ""
            ;;

        basicauth|basic-auth)
            _help_topic_header "HTTP basic auth"
            echo ""
            _help_cmd "cipi basicauth enable <app>"    "Protect app  ${DIM}[--user=N] [--password=P]${NC}"
            _help_cmd "cipi basicauth disable <app>"   "Remove HTTP basic auth"
            _help_cmd "cipi basicauth status <app>"    "Show basic auth status"
            echo ""
            ;;

        deploy|deployment)
            _help_topic_header "Deploy"
            echo ""
            _help_cmd "cipi deploy <app>"              "Deploy via Deployer"
            _help_cmd "cipi deploy <app> --snapshot"   "Deploy with DB dump first"
            _help_cmd "cipi deploy <app> --rollback"   "Rollback"
            _help_cmd "cipi deploy <app> --releases"   "List releases (number, date, commit)"
            _help_cmd "cipi deploy <app> --log[=N]"    "Timestamped deploy log"
            _help_cmd "cipi deploy <app> --key"        "Show SSH deploy key"
            _help_cmd "cipi deploy <app> --webhook"    "Show webhook info"
            _help_cmd "cipi deploy <app> --unlock"     "Unlock a stuck deploy"
            _help_cmd "cipi deploy <app> --trust-host=<host[:port]>" "Trust a custom Git server"
            _help_cmd "cipi deploy <app> --rollback-on-unhealthy" "Undo the release if it fails its healthcheck"
            echo ""
            _help_note "Both deploy paths (CLI and Git webhook) email on success and on failure,"
            _help_note "with different subjects, naming the release, the commit and its author,"
            _help_note "the duration and the post-deploy healthcheck verdict."
            echo ""
            ;;

        worker|workers)
            _help_topic_header "Workers"
            echo ""
            _help_cmd "cipi worker add <app> [--queue=Q]" "Add worker"
            _help_cmd "cipi worker list <app>"         "List workers"
            _help_cmd "cipi worker remove <app> <queue>" "Remove worker"
            _help_cmd "cipi worker restart <app>"      "Restart workers"
            _help_cmd "cipi worker horizon …"          "Horizon  ${DIM}enable|disable|status <app>${NC}"
            echo ""
            ;;

        schedule)
            _help_topic_header "Scheduler"
            echo ""
            _help_cmd "cipi schedule status <app>"     "Show scheduler state"
            _help_cmd "cipi schedule on <app>"         "Enable schedule:run cron"
            _help_cmd "cipi schedule off <app>"        "Disable schedule:run cron"
            echo ""
            ;;

        health)
            _help_topic_header "Healthchecks"
            echo ""
            _help_cmd "cipi health set <app>"          "Configure URL  ${DIM}[--url=] [--expect=200] [--grace=N]${NC}"
            _help_cmd "cipi health unset <app>"        "Remove healthcheck"
            _help_cmd "cipi health check <app>"        "Run probe once"
            _help_cmd "cipi health postdeploy <app>"   "Run the post-deploy verification now"
            _help_cmd "cipi health list"               "List configured checks"
            echo ""
            _help_note "Once a URL is set it is probed two ways:"
            _help_note "  every 5 minutes  — alerts after 3 consecutive failures (ignores blips)"
            _help_note "  after each deploy — retried briefly, then alerts immediately"
            _help_note "The post-deploy check runs for both 'cipi deploy' and the Git webhook."
            _help_note "It never changes the deploy result: the release is live either way, and"
            _help_note "the alert tells you to roll back (cipi deploy <app> --rollback)."
            _help_note "--grace=N waits N seconds before the first probe (Octane apps get 8 by"
            _help_note "default, others 3). Turn it off with: cipi health set <app> --no-postdeploy"
            echo ""
            _help_note "Auto-rollback (opt-in): an unhealthy release can be undone automatically."
            _help_cmd "cipi health set <app> --rollback-on-unhealthy" "Always undo an unhealthy release"
            _help_cmd "cipi deploy <app> --rollback-on-unhealthy"     "Just for this deploy"
            _help_note "It moves the release symlink back and re-checks, then sends one email"
            _help_note "saying what broke and whether the rollback fixed it. Database migrations"
            _help_note "are NOT undone — which is why this is off by default."
            echo ""
            ;;

        monitor)
            _help_topic_header "System monitor"
            echo ""
            _help_cmd "cipi monitor"                   "Run all checks now  ${DIM}[--json]${NC}"
            _help_cmd "cipi monitor list"              "Checks, thresholds, current state"
            _help_cmd "cipi monitor enable|disable <check>" "Toggle a check"
            _help_cmd "cipi monitor set <check> --key=value"  "Thresholds  ${DIM}(disk: warn crit · ssl: days · http_5xx: count ratio · load: factor runs)${NC}"
            _help_cmd "cipi monitor set reminder --minutes=N" "Re-alert interval while failing (default 240)"
            _help_cmd "cipi monitor test"              "Send a test alert to email + channels"
            echo ""
            _help_note "Checks: disk usage, SSL expiry, system services, queue workers,"
            _help_note "HTTP 5xx spikes, read-only filesystem, load average."
            _help_note "Cron runs them every 5 minutes (/etc/cron.d/cipi-monitor). Alerts go"
            _help_note "out on state change only — ok→fail fires once, fail→ok sends a"
            _help_note "recovery, a persisting failure re-alerts every reminder interval."
            _help_note "Delivery: email (cipi smtp configure) and chat channels"
            _help_note "(cipi notifications channel add slack|discord|ntfy|webhook …)."
            echo ""
            ;;

        db|database|databases)
            _help_topic_header "Database"
            echo ""
            _help_cmd "cipi db engines"                "List engines + default"
            _help_cmd "cipi db install <engine>"       "Install engine  ${DIM}mariadb|pgsql${NC}"
            _help_cmd "cipi db uninstall <engine>"     "Remove engine (data lost)"
            _help_cmd "cipi db default <engine>"       "Set default engine"
            _help_cmd "cipi db upgrade [engine]"       "Patch MariaDB / PostgreSQL  ${DIM}[--yes]${NC}"
            _help_note "Omitting the engine upgrades every installed one. Brief downtime."
            _help_cmd "cipi db create"                 "Create database  ${DIM}[--engine=]${NC}"
            _help_cmd "cipi db list"                   "List databases  ${DIM}[--engine=]${NC}"
            _help_cmd "cipi db delete <name>"          "Delete database  ${DIM}[--engine=]${NC}"
            _help_cmd "cipi db backup <name>"          "Backup database  ${DIM}[--engine=]${NC}"
            _help_cmd "cipi db restore <name> <file>"  "Restore database  ${DIM}[--engine=]${NC}"
            _help_cmd "cipi db password <name>"        "Reset DB user password  ${DIM}[--engine=]${NC}"
            _help_note "MariaDB is native (3306). Optional: cipi db install pgsql (5432)"
            _help_note "app create: --engine=mariadb|pgsql (default from cipi db default)"
            echo ""
            ;;

        search|meilisearch|scout)
            _help_topic_header "Search"
            echo ""
            _help_cmd "cipi search install"             "Install Meilisearch  ${DIM}[--version=] [--port=] [--force]${NC}"
            _help_cmd "cipi search status"              "Engine, apps, data size  ${DIM}[--check] [--json]${NC}"
            _help_cmd "cipi search enable <app>"        "Scoped key + Scout .env for one app"
            _help_cmd "cipi search disable <app>"       "Revoke the key  ${DIM}[--purge-indexes]${NC}"
            _help_cmd "cipi search list"                "Apps, prefixes, index counts  ${DIM}[--json]${NC}"
            _help_cmd "cipi search key rotate <app>"    "New key for one app"
            _help_cmd "cipi search key rotate --master" "New master key + rewrite every app"
            _help_cmd "cipi search key show <app>"      "Key uid, actions, index pattern"
            _help_cmd "cipi search upgrade"             "New binary  ${DIM}[--version=] [--reset-data] [--yes]${NC}"
            _help_cmd "cipi search remove"              "Uninstall  ${DIM}[--keep-data] [--force]${NC}"
            echo ""
            _help_note "Off by default. install does not run on setup or self-update."
            _help_note "One instance on 127.0.0.1:7700 — never a public listener, no firewall hole."
            _help_note "Isolation: per-app key scoped to '<app>-*' plus a Cipi-forced SCOUT_PREFIX."
            _help_note "The master key stays in the vault and in a root-only EnvironmentFile."
            _help_note "In the app: composer require laravel/scout meilisearch/meilisearch-php,"
            _help_note "then php artisan scout:import \"App\\\\Models\\\\Post\"."
            _help_note "Indexes are derived data: not in cipi backup, and upgrade may drop them."
            _help_note "Small datasets need no service at all — Scout's 'database' driver is enough."
            echo ""
            ;;

        package|packages|pkg)
            _help_topic_header "Packages"
            echo ""
            _help_cmd "cipi package list"                "Allowlist + what is installed  ${DIM}[--json]${NC}"
            _help_cmd "cipi package install <name>"      "Install one entry  ${DIM}[--yes] [--force]${NC}"
            _help_cmd "cipi package remove <name>"       "Purge it  ${DIM}[--yes] [--autoremove]${NC}"
            echo ""
            _help_note "Allowlist: image-optimizers  ffmpeg  imagemagick  poppler-utils"
            _help_note "A single package inside a group also works (e.g. 'webp', 'jpegoptim')."
            _help_note "Closed on purpose: stateless binaries from Ubuntu repos only — no daemon,"
            _help_note "no port, no state. Anything else is a service (cipi search, cipi db install)."
            _help_note "install shows what apt intends to pull, and asks, before it runs."
            _help_note "Already in the base stack: the Imagick PHP extension, Ghostscript,"
            _help_note "fonts-dejavu-core (Recommends of php-imagick) and Node 20."
            _help_note "Chromium is not here: on Ubuntu it only exists as a snapd transitional"
            _help_note "package. For browsershot use Puppeteer's own Chromium or Google's repo."
            _help_note "ffmpeg belongs in a queue worker, never in a web request."
            echo ""
            ;;

        api)
            _help_topic_header "API"
            echo ""
            _help_cmd "cipi api <domain>"              "Configure API at domain"
            _help_cmd "cipi api ssl"                   "SSL for API domain"
            _help_cmd "cipi api update"                "Update Laravel + cipi-api"
            _help_cmd "cipi api upgrade"               "Full rebuild (fresh Laravel + package)"
            _help_cmd "cipi api status"                "Show API versions and status"
            _help_cmd "cipi api token list|create|revoke" "API token management"
            _help_cmd "cipi api ip-whitelist"          "API client IP allowlist  ${DIM}show|add|remove|set|allow-all${NC}"
            _help_cmd "cipi api fix-permissions"       "Fix panel API ownership (SQLite/logs)"
            _help_note "ip-whitelist default * (all IPs); add GUI server + operator IPs before locking down"
            echo ""
            ;;

        gui|panel)
            _help_topic_header "GUI"
            echo ""
            _help_cmd "cipi gui <domain>"              "Configure web control panel"
            _help_cmd "cipi gui ssl"                   "SSL for GUI domain"
            _help_cmd "cipi gui update"                "Update cipi/gui, migrate, refresh theme"
            _help_cmd "cipi gui refresh-theme"         "Reload GUI CSS/views from package"
            _help_cmd "cipi gui upgrade"               "Full rebuild (fresh Laravel + package)"
            _help_cmd "cipi gui status"                "Show GUI versions and status"
            _help_cmd "cipi gui fix-permissions"       "Repair GUI (open_basedir, vendor, perms)"
            _help_cmd "cipi gui repair"                "Alias for fix-permissions"
            _help_cmd "cipi gui reset-user"            "Reset admin email/password (clears 2FA)"
            _help_cmd "cipi gui remove"                "Remove GUI panel (alias: uninstall)"
            _help_note "reset-user flags: --email= --password= --name="
            _help_note "remove flags: --force"
            _help_note "Requires cipi api on managed servers + API tokens"
            echo ""
            ;;

        git|github|gitlab|bitbucket|azure|origin|codecommit)
            _help_topic_header "Git integration"
            echo ""
            _help_cmd "cipi git status"                "Git provider status"
            _help_cmd "cipi git github-token <token>"  "Save GitHub PAT"
            _help_cmd "cipi git gitlab-token <token>"  "Save GitLab PAT"
            _help_cmd "cipi git gitlab-url <url>"      "Self-hosted GitLab URL"
            _help_cmd "cipi git origin-token <token>"  "Save Cursor Origin API key"
            _help_cmd "cipi git bitbucket-token <token>" "Save Bitbucket API token"
            _help_cmd "cipi git azure-token <PAT>"     "Save Azure DevOps PAT"
            _help_cmd "cipi git codecommit-token <ak> <sk> <user>" "AWS access key + IAM user"
            _help_cmd "cipi git remove-github"         "Remove GitHub token"
            _help_cmd "cipi git remove-gitlab"         "Remove GitLab token + URL"
            _help_cmd "cipi git remove-origin"         "Remove Origin token"
            _help_cmd "cipi git remove-bitbucket"      "Remove Bitbucket token"
            _help_cmd "cipi git remove-azure"          "Remove Azure DevOps PAT"
            _help_cmd "cipi git remove-codecommit"     "Remove CodeCommit credentials"
            _help_cmd "cipi git refresh [app]"         "Re-sync deploy keys + webhooks"
            _help_note "refresh flags: --rotate-keys --rotate-secret --force"
            _help_note "Origin: account SSH key; no per-repo HTTP webhook"
