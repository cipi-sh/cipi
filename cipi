#!/bin/bash

#############################################
# Cipi - Server Control Panel for Laravel
# Version: see /etc/cipi/version
# Author: Andrea Pollastri
# License: MIT
#############################################

set -euo pipefail
{

readonly CIPI_LIB="/opt/cipi/lib"
readonly CIPI_CONFIG="/etc/cipi"
readonly CIPI_VERSION="$(tr -d '[:space:]' < "${CIPI_CONFIG}/version" 2>/dev/null || echo "unknown")"
readonly CIPI_LOG="/var/log/cipi"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; DIM=$'\033[2m'; NC=$'\033[0m'; BOLD=$'\033[1m'

[[ -f "${CIPI_LIB}/common.sh" ]] || {
    echo "Cipi: missing ${CIPI_LIB}/common.sh — run the installer: curl -sSL https://cipi.sh/setup.sh | sudo bash" >&2
    exit 1
}
source "${CIPI_LIB}/common.sh"

# A command that fails where nothing checks it ends cipi (set -e). Say where,
# instead of going back to the prompt in silence — as `cipi db switch mysql`
# did on 5.13.0 right after "Checking the MySQL packages...". Not once an
# error has been printed (that is the message), and not inside $(…),
# pipelines or ( … ): their status is judged by the command that runs them.
_cipi_unexpected_stop() {
    local rc=$? cmd="${BASH_COMMAND}" where
    (( BASH_SUBSHELL == 0 )) || return 0
    [[ -z "${_CIPI_ERROR_SHOWN:-}" ]] || return 0
    _CIPI_ERROR_SHOWN=1
    where="${BASH_SOURCE[1]##*/}:${BASH_LINENO[0]}"
    [[ -n "${FUNCNAME[1]:-}" && "${FUNCNAME[1]}" != main ]] && where+=" in ${FUNCNAME[1]}()"
    echo -e "${RED}[ERROR]${NC} Stopped unexpectedly at ${where} (exit ${rc}): ${cmd}" >&2
    echo -e "        ${DIM}Nothing after it ran. Please report it: https://github.com/cipi-sh/cipi/issues${NC}" >&2
}
set -E
trap _cipi_unexpected_stop ERR

require_root() {
    if [[ $EUID -ne 0 ]]; then
        error "Run as root: sudo cipi $*"
        exit 1
    fi
}

# If first arg is help/-h/--help, show topic help and exit.
_maybe_cmd_help() {
    local topic="$1" arg="${2:-}"
    case "$arg" in
        help|--help|-h) show_help "$topic"; exit 0 ;;
    esac
}

show_logo() {
    echo -e "${GREEN}${BOLD}"
    echo " ██████ ██ ██████  ██"
    echo "██      ██ ██   ██ ██"
    echo "██      ██ ██████  ██"
    echo "██      ██ ██      ██"
    echo " ██████ ██ ██      ██"
    echo -e "${NC}"
}

# ── Help helpers ─────────────────────────────────────────────
# Laid out like `php artisan list`: titles and namespaces in yellow, commands
# in green, their arguments dimmed, descriptions in one column.
_HELP_W=44
_help_h()    { echo -e "\n  ${YELLOW}$1${NC}"; }
_help_note() { echo -e "    ${DIM}$1${NC}"; }

# "cipi app create [--custom]" → _HS_NAME="cipi app create", _HS_ARGS="[--custom]":
# the command words up to the first argument, option or placeholder.
# (read -a, not `for w in $1`: "[--json]" would be a glob.)
_help_split() {
    local -a w; local t in=0
    read -ra w <<< "$1"
    _HS_NAME=""; _HS_ARGS=""
    for t in "${w[@]}"; do
        if (( in == 0 )) && [[ "$t" != [\<\[\(]* && "$t" != *=* && "$t" != -* && "$t" != …* && "$t" != ...* ]]; then
            _HS_NAME+="${_HS_NAME:+ }${t}"
        else
            in=1; _HS_ARGS+="${_HS_ARGS:+ }${t}"
        fi
    done
}

_help_cmd() {
    local shown pad
    _help_split "$1"
    shown="${_HS_NAME}${_HS_ARGS:+ ${_HS_ARGS}}"
    pad=$(( _HELP_W - ${#shown} )); (( pad >= 1 )) || pad=1
    printf "    ${GREEN}%s${NC}${DIM}%s${NC}%*s%s\n" "$_HS_NAME" "${_HS_ARGS:+ ${_HS_ARGS}}" "$pad" "" "$2"
}

_help_topic_header() {
    if [[ -n "${CIPI_HELP_INLINE:-}" ]]; then
        echo -e "\n ${YELLOW}${BOLD}$1${NC}"
        echo -e "  ${DIM}────────────────────────────────────────${NC}"
    else
        show_logo
        echo -e "${GREEN}Cipi${NC} ${YELLOW}${CIPI_VERSION}${NC} ${DIM}— $1${NC}"
    fi
}

# The topics, in alphabetical order (what "Unknown help topic" lists).
_help_topics_list() {
    printf '%s\n' "${_HELP_TOPICS[@]}" | LC_ALL=C sort
}

# The topics, in the order `cipi help all` prints them: the server first, then
# what is done most. `cipi help` — the list of commands — is alphabetical
# whatever this order is; where a command is in two topics, the first one
# here gives it its description (unless the other is its own).
_HELP_TOPICS=(server updates service app use domains www redirect proxy auth basicauth deploy worker schedule
              health monitor metrics db search node api gui git sync ssh ssl php frankenphp package firewall ban
              crowdsec zt scan compliance backup ini yml nginx cache smtp notification valkey reset credentials completion)

# Every command of every topic, one line each: "name<TAB>description", from
# the topics' own _help_cmd lines — the list cannot drift from them. The
# name is the command words, plus the options that make it another command
# (deploy --rollback); the description stops where its dimmed options start.
_help_index() {
    (
        _help_cmd() { printf '%s\t%s\t%s\n' "$1" "$2" "$t" >&3; }
        CIPI_HELP_INLINE=1
        for t in "${_HELP_TOPICS[@]}"; do ( show_help_topic "$t" ) || true; done
    ) 3>&1 >/dev/null 2>&1 | awk -F '\t' -v dim="$DIM" '
        BEGIN { esc = sprintf("%c", 27) }
        $1 !~ /^cipi / { next }
        {
            d = $2; i = index(d, dim); if (i > 1) d = substr(d, 1, i - 1)
            gsub(esc "\\[[0-9;]*m", "", d); sub(/[ \t]+$/, "", d)
            n = split($1, w, " "); name = ""; args = 0
            for (k = 2; k <= n; k++) {
                t = w[k]
                if (!args && t !~ /^[<\[(-]/ && t !~ /=/ && t !~ /^(\.\.\.|…)/) { name = name (name == "" ? "" : " ") t; continue }
                args = 1
                if (t ~ /^--[a-z][a-z-]*$/ && t !~ /^--(json|yes|force|dry-run|print|all|check|clear|quiet|wait|no-[a-z-]+)$/) name = name " " t
            }
            if (name == "") next
            r++; nm[r] = name; ds[r] = d
            split(name, f, " ")
            # A command listed in several topics is shown where its own topic
            # (app limits under app, not under server) puts it.
            if (!(name in pick) || ($3 == f[1] && tp[pick[name]] != f[1])) pick[name] = r
            tp[r] = $3
        }
        END { for (k = 1; k <= r; k++) if (pick[nm[k]] == k) print nm[k] "\t" ds[k] }' \
    | LC_ALL=C sort -t "$(printf '\t')" -k1,1
    # Alphabetical, like `php artisan list`. In the C locale a space sorts
    # before every letter: "db" comes before "db backup", and the commands
    # of a namespace stay together ("app …" all before "auth").
}

show_help() {
    local topic="${1:-}"

    if [[ -n "$topic" ]]; then
        show_help_topic "$topic"
        return
    fi

    # Longer than a screen: through less, from the top (quits when it fits).
    if [[ -t 1 && -z "${CIPI_NO_PAGER:-}" ]] && command -v less >/dev/null 2>&1; then
        # (Quitting less early ends the writer with SIGPIPE: not a failure.)
        CIPI_NO_PAGER=1 show_help | less -R -F -X || true
        return 0
    fi
    local cols; cols=$(tput cols 2>/dev/null || true); [[ "$cols" =~ ^[0-9]+$ ]] || cols=120
    show_logo
    echo -e "${GREEN}Cipi${NC} ${YELLOW}${CIPI_VERSION}${NC} ${DIM}— Server Control Panel for Laravel${NC}"
    echo ""
    echo -e "${YELLOW}Usage:${NC}"
    echo -e "  cipi <command> [arguments] [options]"
    echo -e "  cipi help <topic>                  ${DIM}every option of a command, with notes${NC}"
    echo ""
    echo -e "${YELLOW}Options:${NC}"
    printf "  ${GREEN}%-20s${NC} %s\n" "-h, --help" "Help of a command: cipi db --help, cipi help db" \
                                      "-v, --version" "The version of Cipi" \
                                      "    --json" "Machine-readable output, where a command has it" \
                                      "    --yes" "Go on without asking, where a command asks first"
    echo ""
    # _help_index is sorted: the commands that stand alone come out in
    # alphabetical order, then the namespaces, each with its own in order.
    echo -e "${YELLOW}Available commands:${NC}"
    _help_index | awk -F '\t' -v g="$GREEN" -v y="$YELLOW" -v nc="$NC" -v cols="$cols" '
        { name[NR] = $1; desc[NR] = $2; split($1, w, " "); ns[NR] = w[1]; count[w[1]]++
          if (length($1) > width) width = length($1) }
        END {
            if (width > 32) width = 32
            room = cols - width - 5
            for (i = 1; i <= NR; i++) if (count[ns[i]] == 1 && name[i] !~ / /) line(i)
            for (i = 1; i <= NR; i++) {
                if (count[ns[i]] == 1 && name[i] !~ / /) continue
                if (!(ns[i] in done)) {
                    done[ns[i]] = 1
                    printf " %s%s%s\n", y, ns[i], nc
                    for (j = i; j <= NR; j++) if (ns[j] == ns[i]) line(j)
                }
            }
        }
        function line(k,   d) {
            d = desc[k]
            if (room > 20 && length(d) > room) d = substr(d, 1, room - 1) "…"
            printf "  %s%-" width "s%s  %s\n", g, name[k], nc, d
        }'
    echo ""
    echo -e "  ${DIM}Every option of a command, with notes:${NC} ${GREEN}cipi help <topic>${NC}  ${DIM}·  all of them:${NC} ${GREEN}cipi help all${NC}"
    echo ""
}

show_help_topic() {
    local topic
    topic=$(echo "${1:-}" | tr '[:upper:]' '[:lower:]')

    case "$topic" in
        server|core|status|self-update|version|disk)
            _help_topic_header "Server"
            echo ""
            _help_cmd "cipi status"                    "Server status"
            _help_cmd "cipi disk [--json]"             "Disk usage: the server and every app (GB and %)"
            _help_cmd "cipi disk db [--json]"          "Databases in MB: MariaDB, PostgreSQL, Valkey, Meilisearch"
            _help_cmd "cipi app limits <app> --disk=<GB>|none" "Soft disk limit for an app: alerts, blocks nothing"
            _help_cmd "cipi version"                   "Cipi version"
            _help_cmd "cipi self-update [--check]"     "Update Cipi"
            _help_cmd "cipi pending [--json]"          "What is waiting for you  ${DIM}(cipi help updates)${NC}"
            echo ""
            ;;

        updates|update|autoupdate|pending|reboot|patch|patches)
            _help_topic_header "Updates, pending work, reboot"
            echo ""
            _help_cmd "cipi pending [--json]"          "A reboot, a patch or a warning that is waiting for you"
            _help_cmd "cipi autoupdate"                "What is patched every night, and how the last run went"
            _help_cmd "cipi autoupdate on|off [name]"  "All components, or one"
            _help_cmd "cipi autoupdate run [name]"     "Patch now (what the nightly job runs)"
            _help_cmd "cipi reboot"                    "Is a reboot required, and since when"
            _help_cmd "cipi reboot now [--yes]"        "Restart the server in one minute"
            _help_cmd "cipi reboot auto on [--at=HH:MM]" "Restart at night, only when one is required  ${DIM}(default 04:45)${NC}"
            _help_cmd "cipi reboot auto off"           "Back to a reboot by hand"
            _help_note "names: nginx mariadb pgsql valkey node composer frankenphp — patch releases only, 04:20 every night."
            _help_note "frankenphp: an Octane app moves only within its PHP minor and FrankenPHP major (cipi help frankenphp)."
            _help_note "A database is left for the next night while a dump or a deploy is running."
            _help_note "PHP has its own job (cipi php upgrade, 03:30); Ubuntu's security updates are unattended-upgrades."
            _help_note "pending is checked every morning and mailed when the list changes (trigger pending_report)."
            _help_note "It also names PHP extensions installed with PECL: Cipi installs extensions from apt only."
            echo ""
            ;;

        valkey|redis)
            _help_topic_header "Valkey per app"
            echo ""
            _help_cmd "cipi valkey list [--json]"      "Which app uses which instance"
            _help_cmd "cipi valkey isolate <app>"      "Give the app its own instance: own port, own password, own data"
            _help_cmd "cipi valkey isolate --all"      "Every app that still uses the shared one"
            _help_cmd "cipi valkey share <app>"        "Back to the shared instance"
            _help_cmd "cipi valkey restart <app>"      "Restart one app's instance"
            _help_note "New apps get their own instance. An existing app keeps the shared one until you isolate it:"
            _help_note "its keys are copied, .env is switched (REDIS_HOST/PORT/PASSWORD) and its workers restarted."
            _help_note "Options: --no-copy (start empty)  --maxmemory=256mb  --yes"
            _help_note "From the panel too: the server's Valkey tab (cipi/api 1.47, cipi/gui 4.9)."
            echo ""
            ;;

        cache|page-cache|pagecache)
            _help_topic_header "Page cache (nginx)"
            echo ""
            _help_cmd "cipi cache [list] [--json]"          "Every app: cache on or off, pages kept, space taken"
            _help_cmd "cipi cache <app> on"                  "nginx keeps the pages PHP makes  ${DIM}[--ttl=10m] [--size=256m] [--exclude=/cart*,/feed] [--no-deploy-clear]${NC}"
            _help_cmd "cipi cache <app> off"                 "Every request runs PHP again; the cached pages are deleted"
            _help_cmd "cipi cache <app> ttl <time>"          "How long a page is kept  ${DIM}30s · 10m · 1h · 7d${NC}"
            _help_cmd "cipi cache <app> size <size>"         "How much of the disk it may take  ${DIM}256m · 2g${NC}"
            _help_cmd "cipi cache <app> clear"               "Delete the cached pages now"
            _help_cmd "cipi cache <app> exclude"             "Paths of its own never cached  ${DIM}add '/cart*' · remove <path> · remove --all · set a,b${NC}"
            _help_cmd "cipi cache <app> [status] [--json]"   "On or off, time kept, pages and bytes now"
            _help_note "Not OPcache, which is on already and keeps PHP's compiled code: with this one nginx"
            _help_note "answers with the page itself and PHP does not run. Made for WordPress and sites whose"
            _help_note "pages are the same for every visitor; PHP-FPM (fastcgi_cache) and Octane (proxy_cache)."
            _help_note "Never cached: signed-in visitors, carts, admin pages, an Authorization header, query"
            _help_note "strings (tracking parameters apart), and whatever the app marks private or gives a cookie."
            _help_note "A path of your own to keep out — a page per visitor that says so with no cookie, a feed:"
            _help_note "cipi cache <app> exclude add '/cart*' '/feed'   (* is anything; without it, the path itself)"
            _help_note "Emptied after every successful deploy and rollback. In a recipe or a script of your own,"
            _help_note "as the app's user: sudo /usr/local/bin/cipi-cache-clear <app>"
            _help_note "X-Cache-Status in the response says HIT, MISS, BYPASS, EXPIRED or STALE."
            echo ""
            ;;

        completion|complete)
            _help_topic_header "Shell completion"
            echo ""
            _help_cmd "cipi completion bash [--print]"  "Install bash tab-completion"
            _help_cmd "cipi completion zsh [--print]"   "Install zsh tab-completion"
            echo ""
            _help_note "setup.sh and every 'cipi self-update' install this already: login"
            _help_note "shells through /etc/profile.d, and root and the cipi user in every"
            _help_note "other shell (sudo -s, su, tmux) through ~/.bashrc. You only need this"
            _help_note "command for another user or a custom rc file."
            _help_note "It writes /etc/bash_completion.d/cipi and a loader in your rc file;"
            _help_note "--print writes the script to stdout and changes nothing."
            _help_note "'sudo cipi <Tab>' works with or without the bash-completion package,"
            _help_note "and app names complete for every user."
            echo ""
            ;;

        service|services)
            _help_topic_header "Services"
            echo ""
            _help_cmd "cipi service list [service]"         "Services status"
            _help_cmd "cipi service restart [service|all]"  "Restart service(s)"
            _help_cmd "cipi service start <service>"        "Start a service"
            _help_cmd "cipi service stop <service>"         "Stop a service"
            _help_cmd "cipi service upgrade [name]"         "Patch nginx / MariaDB / PostgreSQL / Valkey  ${DIM}[--yes]${NC}"
            _help_note "services: nginx mariadb postgresql supervisor fail2ban crowdsec cloudflared php<ver>-fpm"
            _help_note "upgrade is patch-level only and asks first. The same runs every night"
            _help_note "without asking: cipi autoupdate. No name lists installed versions."
            echo ""
            ;;

        app|apps)
            _help_topic_header "Apps"
            _help_h "Lifecycle"
            _help_cmd "cipi app create [--custom]"     "Create app  ${DIM}[--env=production|staging|…] [--engine=] [--octane] [--valkey=own|shared] [--node-build=CMD]${NC}"
            _help_note "Without flags a menu asks the type (Laravel, custom, Node spa/static/ssr), FPM or Octane,"
            _help_note "the database engine, then the details and an optional asset build (npm ci && npm run build)."
            _help_note "Laravel Octane: --octane or --octane=frankenphp (no FPM; Nginx → Octane)"
            _help_note "--env is the app's environment label (default production): written to .env as"
            _help_note "APP_ENV / CIPI_ENV, and the app reads cipi-<env>.yml before cipi.yml."
            _help_note "The deploy key is tested against the repository right away (also on app edit)."
            _help_note "--custom: plain PHP or a static site in ~/htdocs; --docroot=www serves a folder in it."
            _help_note "Without --repository (SFTP only) the domain shows a Coming soon page until an index.php"
            _help_note "or index.html of yours is in the document root: it then answers, with nothing to delete."
            _help_note "--db=NAME (custom and Node apps): a new database made with the app and shown as its own, on"
            _help_note "--engine= or the server's default; --db alone names it like the app. Without the flag a"
            _help_note "terminal asks (--no-db: no question). A Laravel app is created with its own, as before."
            _help_cmd "cipi app create --node=spa|static|ssr" "Node frontend  ${DIM}[--framework=next|nuxt|sveltekit|astro|remix|vite]${NC}"
            _help_note "See: cipi help node"
            _help_cmd "cipi app list"                  "List apps"
            _help_cmd "cipi app show <app>"            "App details"
            _help_cmd "cipi app edit <app>"            "Edit app  ${DIM}[--domain=] [--php=] [--branch=] [--env=] [--node-build=]${NC}"
            _help_note "--php= (also on app create) refuses a PHP still waiting for extensions (cipi pending); --force to go on."
            _help_cmd "cipi app convert <app>"         "FPM ↔ Octane  ${DIM}--to=octane|fpm${NC}"
            _help_cmd "cipi app clone <app>"           "Clone app (staging)  ${DIM}--domain= [--env=staging] [--branch=] [--with-db]${NC}"
            _help_cmd "cipi app reverb …"              "Reverb WebSockets  ${DIM}enable|disable|status${NC}"
            _help_note "enable [--restart-supervisor] — lifts Supervisor's open-file limit now (restarts every worker)"
            _help_cmd "cipi app limits <app>"          "Resource limits  ${DIM}[--fpm-max-children=] [--disk=<GB>|none]${NC}"
            _help_cmd "cipi app jit <app> [on|off]"    "PHP JIT for one app  ${DIM}[--mode=tracing|function] [--buffer=128M] [--json]${NC}"
            _help_note "PHP-FPM or Octane; checked before and after, the previous setting comes back if the app does not start."
            _help_cmd "cipi app delete <app>"          "Delete app"
            _help_cmd "cipi app suspend <app>"         "Take offline (503)"
            _help_cmd "cipi app unsuspend <app>"       "Bring back online"
            _help_h "Runtime"
            _help_cmd "cipi app env <app>"             "Edit .env (nano)  ${DIM}[--show|--get=K|--set=K=V|--unset=K|--order=K1,K2,…] [--json]${NC}"
            _help_cmd "cipi app logs <app> [--type=T]" "Tail logs"
            _help_cmd "cipi app tinker <app>"          "Laravel Tinker"
            _help_cmd "cipi app artisan <app> <cmd>"   "Artisan command"
            _help_cmd "cipi app run <app> <cmd> …"     "Whitelisted non-interactive cmd  ${DIM}(composer, npm, ls, …)${NC}"
            _help_cmd "cipi app run --commands"        "List allowed app run binaries  ${DIM}[--json]${NC}"
            _help_cmd "cipi app deploy-config <app>"   "Show/edit deploy.php options  ${DIM}[--json] [--keep-releases=N] [--build-timeout=S] [--step-timeout=S] …${NC}"
            _help_h "Credentials"
            _help_cmd "cipi app reset-password <app>"    "Reset app SSH password"
            _help_cmd "cipi app reset-db-password <app>" "Reset app DB password"
            _help_h "Repair"
            _help_cmd "cipi app fix-permissions [app]"   "Restore home/.ssh/.env/logs modes"
            echo ""
            ;;

        domain|domains|alias|aliases)
            _help_topic_header "Domains & aliases"
            echo ""
            _help_cmd "cipi domains"                   "Map all domains/aliases to apps"
            _help_cmd "cipi alias add <app> <domain>"  "Add alias"
            _help_cmd "cipi alias remove <app> <domain>" "Remove alias"
            _help_cmd "cipi alias list <app>"          "List aliases"
            _help_note "A domain may be a wildcard (*.example.com), as primary or as alias — quote it."
            _help_note "Wildcard certificates are DNS-01 only: cipi ssl install <app> --dns=cloudflare (cipi help ssl)"
            _help_note "See also: cipi help www"
            echo ""
            ;;

        www)
            _help_topic_header "WWW redirects"
            echo ""
            _help_cmd "cipi www add <app>"             "Add www (or apex) alias"
            _help_cmd "cipi www force-to-root <app>"   "Redirect www → apex"
            _help_cmd "cipi www force-from-root <app>" "Redirect apex → www"
            _help_cmd "cipi www clear <app>"           "Clear www canonical redirect"
            _help_cmd "cipi www status <app>"          "Show www redirect status"
            echo ""
            ;;

        redirect|redirects)
            _help_topic_header "Redirects"
            _help_h "Whole app"
            _help_cmd "cipi redirect set <app> --to=<url>"  "Redirect every request  ${DIM}[--301|--302|--307|--308] [--no-path]${NC}"
            _help_cmd "cipi redirect disable <app>"         "Serve the app again, keep the target"
            _help_cmd "cipi redirect enable <app>"          "Re-enable the saved target"
            _help_cmd "cipi redirect unset <app>"           "Forget the app redirect"
            _help_h "Paths"
            _help_cmd "cipi redirect add <app> <from> <to>" "Path redirect  ${DIM}[--301|--302|--307|--308] [--no-path]${NC}"
            _help_cmd "cipi redirect remove <app> <from>"   "Remove a path redirect"
            _help_cmd "cipi redirect list <app> [--json]"   "Show app + path redirects"
            echo ""
            _help_note "Default code 301. 307/308 keep the method and body (POST stays POST)."
            _help_note "<to> is a /path on the same app or an http(s):// URL."
            _help_note "A <from> ending in / is a prefix: /blog/x?y → <to>x?y (the rest of the"
            _help_note "path and the query are kept; --no-path sends all of it to <to> as is)."
            _help_note "Otherwise <from> is exact and only the query string is carried over."
            _help_note "set keeps the path by default: old.com/a?b → https://new.com/a?b."
            _help_note "Path redirects and proxies keep working while the app redirect is on."
            _help_note "Every change runs nginx -t and is reverted if nginx refuses it."
            _help_note "See also: cipi help www (www ↔ apex), cipi help proxy"
            echo ""
            ;;

        proxy|proxies|gateway)
            _help_topic_header "Reverse proxy (prefix)"
            echo ""
            _help_cmd "cipi proxy add <app> <prefix> <url>" "Proxy <prefix>* to an upstream"
            _help_note "  --strip-prefix     /api/users → <url>/users  (default: /api/users → <url>/api/users)"
            _help_note "  --preserve-host    send the visitor's Host (default: the upstream's)"
            _help_note "  --timeout=N        read/send timeout in seconds (default 60, max 3600)"
