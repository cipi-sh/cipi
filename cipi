show_status() {
    show_logo
    echo -e "${BOLD}Server Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    local ip; ip=$(curl -s --max-time 5 https://checkip.amazonaws.com 2>/dev/null || echo "N/A")
    echo -e "\n${BOLD}System${NC}"
    printf "  %-14s ${CYAN}%s${NC}\n" "IP" "$ip"
    printf "  %-14s ${CYAN}%s${NC}\n" "Hostname" "$(hostname)"
    printf "  %-14s ${CYAN}%s${NC}\n" "OS" "$(lsb_release -ds 2>/dev/null)"
    printf "  %-14s ${CYAN}%s${NC}\n" "Uptime" "$(uptime -p 2>/dev/null)"
    printf "  %-14s ${CYAN}v%s${NC}\n" "Cipi" "$CIPI_VERSION"

    local cpu; cpu=$(top -bn1 2>/dev/null | grep -E "Cpu|CPU" | head -1 | awk '{print $2}' | cut -d. -f1) || cpu="?"
    local mem_total; mem_total=$(free -m | awk '/^Mem:/{print $2}')
    local mem_used; mem_used=$(free -m | awk '/^Mem:/{print $3}')
    echo -e "\n${BOLD}Resources${NC}"
    printf "  %-14s ${CYAN}%s%%${NC}\n" "CPU" "$cpu"
    printf "  %-14s ${CYAN}%sMB / %sMB (%s%%)${NC}\n" "Memory" "$mem_used" "$mem_total" "$((mem_used*100/mem_total))"
    printf "  %-14s ${CYAN}%s${NC}\n" "Disk" "$(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')"

    echo -e "\n${BOLD}Services${NC}"
    local -a status_svcs=(nginx mariadb supervisor fail2ban)
    systemctl list-unit-files --quiet postgresql.service &>/dev/null && status_svcs+=(postgresql)
    # Opt-in, so it is listed only where it exists.
    systemd_unit_exists meilisearch && status_svcs+=(meilisearch)
    systemd_unit_exists crowdsec && status_svcs+=(crowdsec)
    systemd_unit_exists crowdsec-firewall-bouncer && status_svcs+=(crowdsec-firewall-bouncer)
    # The rescue listener is the way back in after a ban; a silent one is worse
    # than no listener at all, so it belongs on the status page.
    systemd_unit_exists cipi-crowdsec-rescue && status_svcs+=(cipi-crowdsec-rescue)
    systemd_unit_exists cloudflared && status_svcs+=(cloudflared)
    for svc in "${status_svcs[@]}"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            printf "  %-26s ${GREEN}● running${NC}\n" "$svc"
        elif systemctl list-unit-files --quiet "${svc}.service" &>/dev/null; then
            printf "  %-26s ${RED}● stopped${NC}\n" "$svc"
        else
            printf "  %-26s ${DIM}● not installed${NC}\n" "$svc"
        fi
    done

    echo -e "\n${BOLD}PHP${NC}"
    for v in 8.4 8.5; do
        if systemctl is-active --quiet "php${v}-fpm" 2>/dev/null; then
            local pools; pools=$(ls /etc/php/${v}/fpm/pool.d/*.conf 2>/dev/null | wc -l)
            printf "  %-16s ${GREEN}● running${NC} (%d pools)\n" "PHP $v" "$pools"
        fi
    done

    local count=0
    [[ -f "${CIPI_CONFIG}/apps.json" ]] && count=$(vault_read apps.json | jq 'length' 2>/dev/null || echo 0)
    echo -e "\n${BOLD}Apps:${NC} ${CYAN}${count}${NC}\n"
}

